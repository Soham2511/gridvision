# Copy this file to .env and replace placeholders before starting Compose.
# On EC2, use absolute paths on persistent EBS storage.
GRIDVISION_DATA_DIR=/absolute/path/to/gridvision/data
GRIDVISION_LOG_DIR=./logs
SECRET_KEY=replace-with-a-long-random-secret
DEMO_USER_ID=replace-with-a-demo-user
DEMO_PASSWORD=replace-with-a-unique-random-password

# Public browser traffic uses Nginx's same-origin /api proxy.
VITE_API_BASE_URL=/api/v1
GRIDVISION_FRONTEND_HOST_PORT=8082

# Private Ollama base URL, reachable from the backend container.
# Local Docker default. On EC2, replace with the Ollama machine's private VPN
# DNS name/IP (for example, http://ollama.internal:11434). The EC2 backend
# must be joined to the same private network. Do not expose port 11434 publicly.
GRIDVISION_OLLAMA_BASE_URL=http://host.docker.internal:11434
# Host URL used by automation preflight checks.
OLLAMA_HOST_BASE_URL=http://127.0.0.1:11434
COMMERCIAL_LLM_PROVIDER=ollama
COMMERCIAL_OLLAMA_PRIMARY_MODEL=qwen3:8b
COMMERCIAL_OLLAMA_FALLBACK_MODEL=gemma3:4b
COMMERCIAL_OLLAMA_TIMEOUT_SECONDS=180

# Optional integrations. Leave blank when they are not configured.
TAVILY_API_KEY=
REPORT_EMAIL_FROM_ADDRESS=
REPORT_EMAIL_DEFAULT_RECIPIENT=
REPORT_EMAIL_SMTP_HOST=
REPORT_EMAIL_SMTP_PORT=587
REPORT_EMAIL_SMTP_USERNAME=
REPORT_EMAIL_SMTP_PASSWORD=

# Direct Compose deployments must explicitly approve these prepared datasets.
APPROVED_DATA_SOURCES=customer_gold,customer_silver,commercial_silver,commercial_gold,government_2018,segmentation_2018,anomaly_synthetic_2019

# Scoped LangSmith tracing for the Government redistribution assistant.
GOVT_ASSISTANT_LANGSMITH_TRACING=true
GOVT_ASSISTANT_LANGSMITH_PROJECT=GridVision-Government-Assistant

# Government query router, anomaly assistant, and redistribution interpreter.
# Keep their endpoints pointed at the same private Ollama server. Update all
# three for EC2; localhost/host.docker.internal on EC2 refer to EC2/Docker,
# not to your development computer. Do not publish Ollama port 11434.
GRIDVISION_ROUTER_OLLAMA_URL=http://host.docker.internal:11434
GRIDVISION_ROUTER_MODEL=qwen3:8b
GRIDVISION_ANOMALY_OLLAMA_BASE_URL=http://host.docker.internal:11434
GRIDVISION_ANOMALY_CHAT_MODEL=qwen3:8b
GRIDVISION_ANOMALY_EMBEDDING_MODEL=qwen3-embedding:0.6b
GRIDVISION_ANOMALY_REQUEST_TIMEOUT_SECONDS=180
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_QUERY_MODEL=qwen3:1.7b
OLLAMA_RESPONSE_MODEL=batiai/gemma4-e2b:q4
OLLAMA_TIMEOUT_SECONDS=180
