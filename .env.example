# Safe local defaults only. Never place credentials or real customer data here.
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
MODEL_REGISTRY_CONFIG=configs/model_registry.yaml
RESIDENTIAL_MODEL_PATH=artifacts/models/residential/current_pipeline.pkl
COMMERCIAL_MODEL_PATH=artifacts/models/commercial/current_pipeline.pkl
GOVERNMENT_MODEL_PATH=artifacts/models/government/current_pipeline.pkl
DATA_ROOT=data
ARTIFACT_ROOT=artifacts
RESIDENTIAL_TARIFF_INR_PER_KWH=10
REQUEST_TIMEOUT_SECONDS=10
ENABLE_PREDICTION_PERSISTENCE=false
ALLOWED_ORIGINS=[]
