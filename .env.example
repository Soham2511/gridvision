# Copy these settings into your ignored local .env file.
DEMO_USER_ID=automotive-demo
DEMO_PASSWORD=replace-with-a-unique-random-password

# Ollama runs on the WSL host. The host URL is for automation preflight;
# the backend URL must be reachable from Docker.
COMMERCIAL_LLM_PROVIDER=ollama
OLLAMA_HOST_BASE_URL=http://127.0.0.1:11434
COMMERCIAL_OLLAMA_BASE_URL=http://host.docker.internal:11434
COMMERCIAL_OLLAMA_PRIMARY_MODEL=qwen3:8b
COMMERCIAL_OLLAMA_FALLBACK_MODEL=gemma3:4b
COMMERCIAL_OLLAMA_TIMEOUT_SECONDS=180

# Compose also requires the existing GridVision settings, including:
# SECRET_KEY, GRIDVISION_DATA_DIR, and any paths for your local datasets.
