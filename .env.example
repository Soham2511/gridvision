# ==============================================================================
# GridVision — Environment Variables Configuration
# Copy this file to .env before starting containers: cp .env.example .env
# ==============================================================================

# Public HTTP port on host interface (e.g. 80 on EC2 or 3000 for local dev)
FRONTEND_PORT=80

# Backend Flask environment: 'production' | 'development' | 'testing'
FLASK_ENV=production
FLASK_DEBUG=0

# Secret key for session management and signing (set a long random string in production)
SECRET_KEY=replace-with-a-secure-random-secret-key-for-production-deployment

# Model Provider: 'mlflow' (connects to MLflow container) | 'development' (demo engine)
MODEL_PROVIDER=mlflow
MLFLOW_TRACKING_URI=http://mlflow:5001
MLFLOW_MODEL_NAME=customer-bill-prediction
MLFLOW_MODEL_ALIAS=champion
CUSTOMER_TARIFF_INR_PER_KWH=10.0

# Data Provider: 'sample' (in-memory benchmark grid data) | 'database'
DATA_PROVIDER=sample

# CORS Origins (comma-separated; in container mode reverse proxy handles same-origin requests)
CORS_ORIGINS=*
