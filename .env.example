# Copy this file to .env and replace placeholders before starting Compose.
# On EC2, use absolute paths on persistent EBS storage.
GRIDVISION_DATA_DIR=/absolute/path/to/gridvision/data
GRIDVISION_LOG_DIR=./logs
SECRET_KEY=replace-with-a-long-random-secret
DEMO_USER_ID=replace-with-a-demo-user
DEMO_PASSWORD=replace-with-a-unique-random-password

# Public browser traffic uses Nginx's same-origin /api proxy.
VITE_API_BASE_URL=/api/v1
GRIDVISION_FRONTEND_HOST_PORT=8082

# Private Ollama base URL, reachable from the backend container.
# Local default. On EC2, replace with the private endpoint URL.
# Do not expose Ollama publicly.
GRIDVISION_OLLAMA_BASE_URL=http://host.docker.internal:11434
# Host URL for other local services that call Ollama.
OLLAMA_HOST_BASE_URL=http://127.0.0.1:11434
COMMERCIAL_LLM_PROVIDER=groq
COMMERCIAL_GROQ_API_KEY_FILE=key_vault/groq/api.key
COMMERCIAL_GROQ_BASE_URL=https://api.groq.com
COMMERCIAL_GROQ_MODEL=openai/gpt-oss-20b
COMMERCIAL_GROQ_TIMEOUT_SECONDS=60

# Optional integrations. Leave blank when they are not configured.
TAVILY_API_KEY=
REPORT_EMAIL_FROM_ADDRESS=
REPORT_EMAIL_DEFAULT_RECIPIENT=
REPORT_EMAIL_SMTP_HOST=
REPORT_EMAIL_SMTP_PORT=587
REPORT_EMAIL_SMTP_USERNAME=
REPORT_EMAIL_SMTP_PASSWORD=

# Direct Compose deployments must explicitly approve these prepared datasets.
APPROVED_DATA_SOURCES=customer_gold,customer_silver,commercial_silver,commercial_gold,government_2018,segmentation_2018,anomaly_synthetic_2019
