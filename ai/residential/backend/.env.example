# GridVision Flask Backend Configuration
FLASK_ENV=development
FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5000
SECRET_KEY=gridvision-insecure-dev-secret-key-change-in-production

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Model Provider Configuration: 'development' | 'mlflow'
MODEL_PROVIDER=development

# Customer bill MLflow model (optional; leave MODEL_PROVIDER=development otherwise)
# MLFLOW_TRACKING_URI=http://localhost:5001
# MLFLOW_MODEL_NAME=customer-bill-prediction
# MLFLOW_MODEL_ALIAS=champion
# CUSTOMER_TARIFF_INR_PER_KWH=10.0

# Data Provider Configuration: 'sample' | 'database'
DATA_PROVIDER=sample

# Government & Utilities AI assistant routing (local Ollama)
GRIDVISION_ROUTER_MODEL=qwen3:8b
GRIDVISION_ROUTER_OLLAMA_URL=http://localhost:11434

# LLM Assistant Provider Configuration (Ollama Active Runtime)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# For Docker Compose, use http://host.docker.internal:11434 to reach host Ollama.

# Inactive Groq Configuration (Retained for manual switch-back)
# GROQ_API_KEY=your-groq-api-key-here
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-120b
