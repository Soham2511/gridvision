FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    FLASK_ENV=production \
    HOST=0.0.0.0 \
    PORT=5000

WORKDIR /app
COPY requirements.txt ./requirements.txt
COPY scripts/filter_requirements.py ./scripts/filter_requirements.py
RUN python scripts/filter_requirements.py requirements.txt /tmp/backend-requirements.txt --groups backend model-serving \
    && pip install --no-cache-dir -r /tmp/backend-requirements.txt
COPY backend/app ./app
COPY backend/run.py ./run.py

EXPOSE 5000
CMD ["waitress-serve", "--host=0.0.0.0", "--port=5000", "run:app"]
