# GridVision Flask Backend Configuration
FLASK_ENV=development
FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5000
SECRET_KEY=gridvision-insecure-dev-secret-key-change-in-production

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Model Provider Configuration: 'development' | 'mlflow'
MODEL_PROVIDER=development

# Customer bill MLflow model (optional; leave MODEL_PROVIDER=development otherwise)
# MLFLOW_TRACKING_URI=http://localhost:5001
# MLFLOW_MODEL_NAME=customer-bill-prediction
# MLFLOW_MODEL_ALIAS=champion
# CUSTOMER_TARIFF_INR_PER_KWH=10.0

# Data Provider Configuration: 'sample' | 'database'
DATA_PROVIDER=sample
